FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    langchain \
    langchain-community \
    langchain-ollama \
    langchain-neo4j \
    neo4j

# The layout of a checkout, so the script finds what it looks for next to itself: the pykci
# package in ../src (its connection settings, pykci.runtime) and GRAPH.md / CYPHER.md one
# level up, which it gives the model as context.
COPY src/pykci src/pykci
COPY db-llm db-llm
COPY GRAPH.md CYPHER.md ./

ENTRYPOINT ["python", "-u", "db-llm/query_ollama_full.py"]
